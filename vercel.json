{
  "buildCommand": "pnpm --filter @workspace/glam-by-ankita build",
  "outputDirectory": "artifacts/glam-by-ankita/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/melbourne-cbd-makeup-artist", "destination": "/services", "permanent": true },
    { "source": "/melbourne-cbd-makeup-artist/", "destination": "/services", "permanent": true }
  ],
  "rewrites": [
    { "source": "/r", "destination": "/api/r" },
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/about/", "destination": "/about/index.html" },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/services/", "destination": "/services/index.html" },
    { "source": "/gallery", "destination": "/gallery/index.html" },
    { "source": "/gallery/", "destination": "/gallery/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/contact/", "destination": "/contact/index.html" },
    { "source": "/bridal-makeup-melbourne", "destination": "/bridal-makeup-melbourne/index.html" },
    { "source": "/bridal-makeup-melbourne/", "destination": "/bridal-makeup-melbourne/index.html" },
    { "source": "/glam-makeup-melbourne", "destination": "/glam-makeup-melbourne/index.html" },
    { "source": "/glam-makeup-melbourne/", "destination": "/glam-makeup-melbourne/index.html" },
    { "source": "/editorial-makeup-melbourne", "destination": "/editorial-makeup-melbourne/index.html" },
    { "source": "/editorial-makeup-melbourne/", "destination": "/editorial-makeup-melbourne/index.html" },
    { "source": "/p", "destination": "/index.html" },
    { "source": "/p/:token([a-f0-9]{64})", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/sign-in", "destination": "/index.html" },
    { "source": "/sign-in/:path*", "destination": "/index.html" },
    { "source": "/sign-up", "destination": "/index.html" },
    { "source": "/sign-up/:path*", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/r", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/p", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/p/:token([a-f0-9]{64})", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/account", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/sign-in", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/sign-in/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/sign-up", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/sign-up/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
